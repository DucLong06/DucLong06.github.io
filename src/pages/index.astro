---
/**
 * index.astro — EN home page.
 * 3D island (progressive enhancement) + full 2D site fallback via PortfolioHome.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioHome from '../components/astro/PortfolioHome.astro';

const lang = 'en' as const;
---

<BaseLayout
  title="Hoàng Đức Long — Full-stack AI Engineer"
  description="Full-stack AI engineer shipping production ML at telecom scale. Python · C++ · .NET · TypeScript."
  lang={lang}
>
  <PortfolioHome lang={lang} currentPath={Astro.url.pathname} />
</BaseLayout>
