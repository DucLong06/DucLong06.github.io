---
/**
 * explore.astro — EN interactive 3D portfolio (/explore).
 * Canonical points to the classic home (/) so crawlers + OG never depend on JS.
 * The R3F island mounts client:only; a crawlable fallback renders pre-hydration.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreRoot from '../components/react/explore/explore-root';
import { getExploreData } from '../lib/explore-data';
import { getEntry } from 'astro:content';
import { t } from '../lib/i18n-helpers';
import '../styles/explore.css';

const lang = 'en' as const;
const siteUrl = 'https://duclong06.github.io';
const classicUrl = `${siteUrl}/`;
const profile = await getEntry('profile', 'main');
const cvHref = profile.data.cvFile;
const data = await getExploreData(lang);
---

<BaseLayout
  title="Hoàng Đức Long — Explore in 3D"
  description="Interactive 3D portfolio of Hoàng Đức Long — full-stack AI engineer. Explore experience, work, papers, skills and more."
  lang={lang}
  canonical={classicUrl}
>
  <main id="main-content" class="explore-page" tabindex="-1">
    <ExploreRoot
      client:only="react"
      locale={lang}
      classicUrl="/"
      cvHref={cvHref}
      data={data}
    >
      <div slot="fallback" class="explore-state">
        <p class="explore-state__title">{t('explore_loading', lang)}</p>
        <a class="explore-state__link" href="/">{t('explore_view_classic', lang)} →</a>
      </div>
    </ExploreRoot>
    <noscript>
      <div class="explore-state explore-state--card">
        <p class="explore-state__body">{t('explore_fallback_body', lang)}</p>
        <a class="explore-btn explore-btn--primary" href="/">{t('explore_view_classic', lang)} →</a>
      </div>
    </noscript>
  </main>
</BaseLayout>
