---
/**
 * Hero.astro — Full-viewport hero with the 3D knowledge graph as the backdrop.
 * The graph (GraphCanvas island, client:visible) is the aesthetic + navigation
 * hub; the name/headline/CTAs stay as real HTML overlaid on top (content-first
 * for SEO/no-JS/a11y). Bilingual via lang prop.
 */
import { getEntry } from 'astro:content';
import GraphCanvas from '../react/graph/GraphCanvas';
import { buildGraphData } from '../../lib/graph/build-graph-data';
import { t, type Lang } from '../../lib/i18n-helpers';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;

const profile = await getEntry('profile', 'main');
const name    = profile.data.name[lang] ?? profile.data.name.en;
const tagline = profile.data.tagline[lang] ?? profile.data.tagline.en;
const email   = profile.data.email;
const cvFile  = profile.data.cvFile;

const graphData = await buildGraphData(lang);
---

<section class="hero" aria-label="Introduction">
  <!-- Knowledge graph backdrop — decorative; real nav lives in <nav> + content -->
  <GraphCanvas data={graphData} hint={t('graph_legend_hint', lang)} client:visible />

  <!-- Hero content overlay (real HTML) -->
  <div class="hero-content">
    <h1 class="hero-name">{name}</h1>

    <p class="hero-tagline">
      {tagline}<br />
      {t('hero_tech_stack', lang)}
    </p>

    <p class="hero-meta">
      {t('hero_meta', lang)}<br />
      <span aria-label="Trophy">🏆</span> {t('hero_award_alqac', lang)} ·
      <span aria-label="Medal">🏅</span> {t('hero_award_saokhe', lang)}.
    </p>

    <!-- CTAs -->
    <div class="hero-ctas" role="list">
      <a href="#work" class="hero-cta hero-cta--primary" role="listitem">
        {t('hero_cta_work', lang)} <span aria-hidden="true">→</span>
      </a>
      <a href={cvFile} class="hero-cta hero-cta--secondary" role="listitem" download>
        {t('hero_cta_cv', lang)}
      </a>
      <a href={`mailto:${email}`} class="hero-cta hero-cta--secondary" role="listitem">
        {t('hero_cta_email', lang)}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
  }

  /* Content anchored bottom-left so the graph breathes in the upper/right area.
     Wrapper ignores pointer events so the graph stays draggable; only links do. */
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: clamp(1.5rem, 5vw, 4rem);
    padding-bottom: clamp(3rem, 8vh, 6rem);
    max-width: 640px;
    gap: 1rem;
    pointer-events: none;
  }

  .hero-name {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-size: clamp(2.75rem, 9vw, 5rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.02em;
    background: var(--aurora-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-tagline {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--text-primary);
    line-height: 1.6;
    max-width: 36rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.6);
  }

  .hero-meta {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.6);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
    pointer-events: auto;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.625rem 1.375rem;
    border-radius: var(--r-md);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--ease-soft),
      box-shadow var(--duration-fast) var(--ease-soft),
      background-color var(--duration-fast) var(--ease-soft);
  }

  .hero-cta--primary {
    background: var(--aurora-gradient);
    color: #0d1b2a;
    font-weight: 600;
  }
  .hero-cta--primary:hover,
  .hero-cta--primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--shadow-aurora);
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  .hero-cta--secondary {
    background: color-mix(in srgb, var(--bg-elevated) 80%, transparent);
    color: var(--text-primary);
    border: 1px solid var(--border-strong);
    backdrop-filter: blur(8px);
  }
  .hero-cta--secondary:hover,
  .hero-cta--secondary:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    background: var(--bg-subtle);
    outline: 2px solid var(--aurora-1);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta { transition: none; }
    .hero-cta:hover,
    .hero-cta:focus-visible { transform: none; }
  }
</style>
