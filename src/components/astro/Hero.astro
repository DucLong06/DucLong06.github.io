---
/**
 * Hero.astro — Full-viewport hero section (dark-techy).
 * OGL liquid shader retired → static CSS techy backdrop (grid + scanline glow,
 * reduced-motion safe). Adds a prominent "Explore in 3D" CTA to /explore while
 * keeping the recruiter path (View work / CV / Email) verbatim.
 * Profile data pulled from content collection. Bilingual via lang prop.
 */
import { getEntry } from 'astro:content';
import { t, type Lang } from '../../lib/i18n-helpers';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;

const profile = await getEntry('profile', 'main');
const name    = profile.data.name[lang] ?? profile.data.name.en;
const tagline = profile.data.tagline[lang] ?? profile.data.tagline.en;
const email   = profile.data.email;
const cvFile  = profile.data.cvFile;
const exploreHref = lang === 'vi' ? '/vi/explore' : '/explore';
---

<section class="hero" aria-label="Introduction">
  <!-- Static techy backdrop — grid + neon glow, purely decorative -->
  <div class="hero-backdrop" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="hero-glow hero-glow--cyan"></div>
    <div class="hero-glow hero-glow--magenta"></div>
  </div>

  <!-- Hero content -->
  <div class="hero-content">
    <p class="hero-eyebrow"><span aria-hidden="true">$</span> whoami</p>
    <h1 class="hero-name">{name}</h1>

    <p class="hero-tagline">
      {tagline}<br />
      {t('hero_tech_stack', lang)}
    </p>

    <p class="hero-meta">
      {t('hero_meta', lang)}<br />
      <span aria-label="Trophy">🏆</span> {t('hero_award_alqac', lang)} ·
      <span aria-label="Medal">🏅</span> {t('hero_award_saokhe', lang)}.
    </p>

    <!-- CTAs -->
    <div class="hero-ctas" role="list">
      <a href={exploreHref} class="hero-cta hero-cta--primary" role="listitem">
        {t('explore_to_3d', lang)} <span aria-hidden="true">✦</span>
      </a>
      <a href="#work" class="hero-cta hero-cta--secondary" role="listitem">
        {t('hero_cta_work', lang)} <span aria-hidden="true">→</span>
      </a>
      <a href={cvFile} class="hero-cta hero-cta--secondary" role="listitem" download>
        {t('hero_cta_cv', lang)}
      </a>
      <a href={`mailto:${email}`} class="hero-cta hero-cta--secondary" role="listitem">
        {t('hero_cta_email', lang)}
      </a>
    </div>

    <!-- Scroll hint -->
    <div class="hero-scroll-hint" aria-hidden="true">
      <span class="hero-scroll-arrow">↓</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* ── Techy backdrop ── */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero-grid {
    position: absolute;
    inset: -2px;
    background-image:
      linear-gradient(rgba(230, 233, 245, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(230, 233, 245, 0.04) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, #000 25%, transparent 78%);
  }

  .hero-glow {
    position: absolute;
    width: 60vw;
    height: 60vw;
    max-width: 720px;
    max-height: 720px;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.5;
  }

  .hero-glow--cyan {
    top: -10%;
    left: 5%;
    background: radial-gradient(circle, rgba(52, 226, 255, 0.35), transparent 70%);
    animation: hero-drift-a 16s ease-in-out infinite alternate;
  }

  .hero-glow--magenta {
    bottom: -15%;
    right: 0%;
    background: radial-gradient(circle, rgba(255, 77, 157, 0.28), transparent 70%);
    animation: hero-drift-b 20s ease-in-out infinite alternate;
  }

  @keyframes hero-drift-a {
    to { transform: translate(8%, 10%) scale(1.1); }
  }
  @keyframes hero-drift-b {
    to { transform: translate(-8%, -6%) scale(1.08); }
  }

  /* Content stack above backdrop */
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1.5rem;
    max-width: 860px;
    gap: 1.25rem;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--neon-cyan);
    text-shadow: 0 0 10px rgba(52, 226, 255, 0.35);
    margin: 0;
  }

  /* Display name — Space Grotesk, neon gradient clip with solid fallback */
  .hero-name {
    font-family: var(--font-display);
    font-style: normal;
    font-size: clamp(3rem, 10vw, 5.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-primary); /* fallback if clip unsupported */
    background: var(--aurora-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-tagline {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 560px;
  }

  .hero-meta {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* CTA row */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.625rem 1.375rem;
    border-radius: var(--r-md);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--ease-soft),
      box-shadow var(--duration-fast) var(--ease-soft),
      background-color var(--duration-fast) var(--ease-soft);
  }

  /* Primary = neon cyan fill, dark text (AA-safe) + glow */
  .hero-cta--primary {
    background: var(--neon-cyan-deep);
    color: #04121a;
    box-shadow: 0 0 22px rgba(52, 226, 255, 0.30);
  }

  .hero-cta--primary:hover,
  .hero-cta--primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 0 30px rgba(52, 226, 255, 0.45);
    outline: none;
  }

  .hero-cta--primary:focus-visible {
    outline: 2px solid var(--neon-cyan);
    outline-offset: 3px;
  }

  .hero-cta--secondary {
    background: var(--bg-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border-strong);
  }

  .hero-cta--secondary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    background: var(--bg-subtle);
  }

  .hero-cta--secondary:focus-visible {
    transform: translateY(-2px);
    background: var(--bg-subtle);
    outline: 2px solid var(--neon-cyan);
    outline-offset: 2px;
  }

  /* Scroll hint */
  .hero-scroll-hint {
    margin-top: 1rem;
  }

  .hero-scroll-arrow {
    display: inline-block;
    color: var(--text-tertiary);
    font-size: 1.25rem;
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0);    opacity: 0.5; }
    50%       { transform: translateY(6px); opacity: 1;   }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-arrow,
    .hero-glow--cyan,
    .hero-glow--magenta {
      animation: none;
    }
    .hero-cta {
      transition: none;
    }
    .hero-cta--primary:hover,
    .hero-cta--primary:focus-visible,
    .hero-cta--secondary:hover,
    .hero-cta--secondary:focus-visible {
      transform: none;
    }
  }
</style>
