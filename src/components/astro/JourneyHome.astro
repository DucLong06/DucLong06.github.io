---
/**
 * JourneyHome.astro — Home body wrapper that layers the 3D Data Pipeline Journey
 * over the SSR 2D site.
 *
 * Progressive enhancement: the full PortfolioHome (Nav → Hero → … → Footer) is
 * always server-rendered inside #site-2d for crawlers / no-JS / mobile / reduced
 * motion. The PipelineJourney island (client:only) decides capability at runtime;
 * when it can run, it hides #site-2d (body.journey-active) and takes over the
 * page. Otherwise the 2D site shows unchanged.
 */
import PortfolioHome from './PortfolioHome.astro';
import PipelineJourney from '../react/journey/PipelineJourney';
import { buildJourneyData } from '../../lib/pipeline/build-journey-data';
import type { Lang } from '../../lib/i18n-helpers';

interface Props {
  lang: Lang;
  currentPath: string;
}
const { lang, currentPath } = Astro.props;

const journeyData = await buildJourneyData(lang);
---

{/* 3D journey — mounts only when capability allows; renders nothing otherwise */}
<PipelineJourney data={journeyData} client:only="react" />

{/* SSR 2D baseline — always in the DOM; hidden via CSS while the journey owns the page */}
<div id="site-2d">
  <PortfolioHome lang={lang} currentPath={currentPath} />
</div>
