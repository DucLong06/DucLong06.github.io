---
/**
 * PortfolioHome.astro — Shared home body for EN (/) and VI (/vi/).
 *
 * Two parts, top to bottom:
 *   1. <GuardrailStory> — the scroll/autoplay canvas story (name as an inspected
 *      request → x · W = ŷ → network → chip). Text is server-rendered.
 *   2. The classic sections inside #classic-site — Experience, Skills, Projects,
 *      Papers, Contact — the SEO/no-JS/a11y baseline, all from src/content/**.
 */
import Nav from './Nav.astro';
import Marquee from './Marquee.astro';
import Experience from './Experience.astro';
import Skills from './Skills.astro';
import ProjectsGrid from './ProjectsGrid.astro';
import Papers from './Papers.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import GuardrailStory from './GuardrailStory.astro';
import type { Lang } from '../../lib/i18n-helpers';

interface Props {
  lang: Lang;
  currentPath: string;
}
const { lang, currentPath } = Astro.props;
---

{/*
  Guardrail Story (canvas) replaces Metamorphosis as the home-page opener.
  The classic sections below the track are the SEO/no-JS/a11y baseline —
  recruiters can still Ctrl+F them.
*/}
<GuardrailStory lang={lang} />

<div id="classic-site">
  <Nav lang={lang} />
  <main id="main-content" tabindex="-1">
    <Marquee />
    <Experience lang={lang} />
    <Skills lang={lang} />
    <ProjectsGrid id="work" lang={lang} />
    <Papers lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} currentPath={currentPath} />
</div>
