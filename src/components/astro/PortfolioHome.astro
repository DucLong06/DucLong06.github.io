---
/**
 * PortfolioHome.astro — Shared home body for EN (/) and VI (/vi/).
 *
 * Renders TWO layers:
 *   1. The Neovim/LazyVim shell (React island, client:only) — the primary
 *      interactive experience. On mount it adds `html.nvim-active`, which the
 *      theme CSS reacts to by hiding #classic-site. The 3D island lives inside
 *      the shell, reachable via `:island`.
 *   2. The full server-rendered 2D site inside #classic-site — the SEO / no-JS /
 *      a11y baseline, always present in the DOM (crawlers + no-JS see this).
 *
 * Both layers read the SAME content collections (via buildNvimData →
 * buildSceneData), so editing src/content/** updates everything.
 */
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Marquee from './Marquee.astro';
import Experience from './Experience.astro';
import Skills from './Skills.astro';
import ProjectsGrid from './ProjectsGrid.astro';
import Papers from './Papers.astro';
import GitHubStats from './GitHubStats.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import NvimShell from '../react/nvim/NvimShell';
import { buildNvimData } from '../../lib/nvim/build-nvim-data';
import type { Lang } from '../../lib/i18n-helpers';
import '@fontsource-variable/jetbrains-mono';
import '../../styles/nvim-theme.css';
import '../../styles/nvim-content.css';

interface Props {
  lang: Lang;
  currentPath: string;
}
const { lang, currentPath } = Astro.props;
const nvimData = await buildNvimData(lang);
---

<NvimShell client:only="react" data={nvimData} />

<div id="classic-site">
  <Nav lang={lang} />
  <main id="main-content" tabindex="-1">
    <Hero lang={lang} />
    <About lang={lang} />
    <Marquee />
    <Experience lang={lang} />
    <Skills lang={lang} />
    <ProjectsGrid id="work" lang={lang} />
    <Papers lang={lang} />
    <GitHubStats lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} currentPath={currentPath} />
</div>
