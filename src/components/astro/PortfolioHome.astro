---
/**
 * PortfolioHome.astro — Shared home body for EN (/) and VI (/vi/).
 *
 * Content-first single page (SEO/no-JS/a11y baseline). The only enhancement is
 * the decorative OGL aurora liquid shader behind the Hero (see Hero.astro →
 * LiquidShader island). Everything else is scannable server-rendered HTML.
 */
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import ImpactStrip from './ImpactStrip.astro';
import About from './About.astro';
import Marquee from './Marquee.astro';
import Experience from './Experience.astro';
import Skills from './Skills.astro';
import ProjectsGrid from './ProjectsGrid.astro';
import Papers from './Papers.astro';
import GitHubStats from './GitHubStats.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import type { Lang } from '../../lib/i18n-helpers';

interface Props {
  lang: Lang;
  currentPath: string;
}
const { lang, currentPath } = Astro.props;
---

<Nav lang={lang} />
<main id="main-content" tabindex="-1">
  <Hero lang={lang} />
  <ImpactStrip lang={lang} />
  <About lang={lang} />
  <Marquee />
  <Experience lang={lang} />
  <Skills lang={lang} />
  <ProjectsGrid id="work" lang={lang} />
  <Papers lang={lang} />
  <GitHubStats lang={lang} />
  <Contact lang={lang} />
</main>
<Footer lang={lang} currentPath={currentPath} />
