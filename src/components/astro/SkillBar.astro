---
/**
 * SkillBar.astro — Single skill pill: name + optional yellow years suffix.
 * `level` is accepted for data-compat but intentionally not displayed.
 */
interface Props {
  name: string;
  level?: number;
  years?: number;
}
const { name, years } = Astro.props;
---

<span class="skill">
  <span class="skill__name">{name}</span>
  {years && <span class="skill__years">{years}y</span>}
</span>

<style>
  .skill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  .skill__name {
    color: var(--text-primary);
  }

  .skill__years {
    color: var(--yellow);
  }
</style>
