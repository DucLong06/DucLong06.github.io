---
/**
 * Skills.astro — Skills section, 6 groups in a 2-col grid.
 * Power-bars retired (SkillBar deleted) → compact chips with a level indicator
 * (●●●●○ = 4/5). a11y-native: each chip carries an aria-label with the level.
 * Data from skills/main.yaml via getEntry('skills', 'main').
 */
import { getEntry } from 'astro:content';
import SectionTitle from './SectionTitle.astro';
import { t, type Lang } from '../../lib/i18n-helpers';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;

const skillsData = await getEntry('skills', 'main');
const groups = skillsData!.data.groups as Array<{
  category: string;
  items: Array<{ name: string; level: number; years?: number }>;
}>;
---

<section class="skills section-gap" id="skills" aria-labelledby="skills-heading">
  <div class="container">
    <SectionTitle eyebrow={t('skills_eyebrow', lang)} title={t('skills_title', lang)} />

    <div class="skills-grid">
      {groups.map((group) => (
        <div class="skill-group">
          <h3 class="skill-group__title">{group.category}</h3>
          <ul class="skill-group__chips" role="list">
            {group.items.map((item) => (
              <li
                class="skill-chip"
                role="listitem"
                aria-label={`${item.name}: level ${item.level} of 5`}
                title={item.years ? `${item.name} · ${item.years}y` : item.name}
              >
                <span class="skill-chip__name">{item.name}</span>
                <span class="skill-chip__level" aria-hidden="true">
                  {'●'.repeat(item.level)}{'○'.repeat(5 - item.level)}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-gap { padding: 6rem 0; }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .skills-grid { grid-template-columns: 1fr 1fr; }
  }

  .skill-group {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .skill-group__title {
    font-family: var(--font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--neon-cyan);
    margin: 0 0 1.25rem;
  }

  .skill-group__chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    font-size: 0.8125rem;
  }

  .skill-chip__name {
    color: var(--text-primary);
    font-weight: 500;
  }

  .skill-chip__level {
    font-size: 0.55rem;
    letter-spacing: 0.05em;
    color: var(--neon-cyan);
  }
</style>
