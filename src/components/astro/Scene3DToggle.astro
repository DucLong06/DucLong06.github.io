---
/**
 * Scene3DToggle.astro — Floating "Enter the 3D island" button shown ONLY on the
 * 2D fallback site, and ONLY on devices that could actually run the 3D layer.
 *
 * Why it exists: capable users who picked "Classic view" (persisted as
 * scene-mode='2d') would otherwise be stuck in 2D. This button clears that
 * preference and reloads into the island. Zero JS unless the device is capable.
 *
 * Detection mirrors use-scene-capability.ts (WebGL + width + fine pointer).
 */
import { t, type Lang } from '../../lib/i18n-helpers';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const label = lang === 'vi' ? 'Vào không gian 3D' : 'Enter the 3D space';
---

<button id="enter-3d" type="button" class="enter-3d" hidden aria-label={label}>
  <span class="enter-3d__orb" aria-hidden="true"></span>
  {label}
</button>

<script>
  // Show the button only if the device can run the island and the user isn't
  // already in 3D. Keeps the 2D site clean on phones / no-WebGL machines.
  (() => {
    const btn = document.getElementById('enter-3d');
    if (!btn) return;

    const hasWebGL = () => {
      try {
        const c = document.createElement('canvas');
        return !!(c.getContext('webgl2') || c.getContext('webgl'));
      } catch {
        return false;
      }
    };
    const capable =
      window.innerWidth >= 768 &&
      window.matchMedia('(pointer: fine)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      hasWebGL();

    if (capable) btn.hidden = false;

    btn.addEventListener('click', () => {
      try {
        localStorage.setItem('portfolio-scene-mode', '3d');
      } catch {
        /* ignore */
      }
      location.reload();
    });
  })();
</script>

<style>
  .enter-3d {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--neon) 60%, transparent);
    border-radius: 9999px;
    background: var(--aurora-gradient);
    color: #04111a;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 12px 30px rgba(45, 226, 255, 0.32);
    transition: transform 0.15s ease, box-shadow 0.2s ease;
  }
  .enter-3d:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px rgba(45, 226, 255, 0.45);
  }
  .enter-3d:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }
  .enter-3d__orb {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.3);
    animation: enter3d-pulse 1.8s ease-in-out infinite;
  }
  @keyframes enter3d-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.3); }
    50% { box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.12); }
  }
  @media (prefers-reduced-motion: reduce) {
    .enter-3d { transition: none; }
    .enter-3d__orb { animation: none; }
  }
</style>
