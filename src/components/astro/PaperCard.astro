---
/**
 * PaperCard.astro — Displays a single research paper or award entry.
 * Props mirror the 'papers' collection schema.
 */
interface Props {
  title: string;
  authors: string[];
  venue: string;
  year: number;
  award?: string;
  doi?: string;
  pdf?: string;
}

const { title, authors, venue, year, award, doi, pdf } = Astro.props;
const linkHref = doi ? `https://doi.org/${doi}` : pdf;
---

<article class="paper-card">
  {award && (
    <div class="paper-card__award" aria-label="Award">
      {award}
    </div>
  )}

  <h3 class="paper-card__title">{title}</h3>

  <p class="paper-card__authors">
    {authors.join(' · ')}
  </p>

  <p class="paper-card__venue">
    <span class="paper-card__venue-name">{venue}</span>
    <span class="paper-card__year">{year}</span>
  </p>

  {linkHref && (
    <a
      class="paper-card__link"
      href={linkHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Read paper: ${title}`}
    >
      {doi ? 'View on IEEE →' : 'View Paper →'}
    </a>
  )}
</article>

<style>
  .paper-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    transition: border-color 0.2s ease;
  }

  .paper-card:hover {
    border-color: var(--border-strong);
  }

  .paper-card__award {
    display: inline-flex;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--yellow);
    border: 1px solid color-mix(in srgb, var(--yellow) 40%, transparent);
    /* long award strings wrap, so a soft rectangle reads better than a pill */
    border-radius: var(--r-sm);
    padding: 0.25rem 0.6rem;
    line-height: 1.45;
  }

  .paper-card__title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--text-primary);
    margin: 0;
  }

  .paper-card__authors {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  .paper-card__venue {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    flex-wrap: wrap;
  }

  .paper-card__venue-name {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-secondary);
  }

  .paper-card__year {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--yellow);
  }

  .paper-card__link {
    align-self: flex-start;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--cyan);
    text-decoration: none;
  }

  .paper-card__link:hover {
    color: var(--cyan-hover);
    text-decoration: underline;
  }
</style>
